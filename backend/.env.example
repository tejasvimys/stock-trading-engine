# Stock Trading Engine – Backend Environment Configuration
# Copy this file to .env and fill in your values.

# API server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Stock universe (comma-separated yfinance symbols)
# Default is top 20 NSE large caps. Add/remove as needed.
DEFAULT_TICKERS=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ICICIBANK.NS,HINDUNILVR.NS,BAJFINANCE.NS,SBIN.NS,BHARTIARTL.NS,KOTAKBANK.NS,WIPRO.NS,AXISBANK.NS,LT.NS,HCLTECH.NS,ADANIENT.NS,MARUTI.NS,SUNPHARMA.NS,TITAN.NS,NTPC.NS,ONGC.NS

# Profit target (fraction, default 0.10 = 10%)
PROFIT_TARGET=0.10

# CORS origins. Use * for open access or comma-separated list of allowed origins.
ALLOWED_ORIGINS=*

# Data sync interval in minutes (how often background tasks refresh stock data)
DATA_SYNC_INTERVAL_MINUTES=15
