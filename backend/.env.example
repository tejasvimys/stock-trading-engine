# Stock Trading Engine – Backend Environment Configuration
# Copy this file to .env and fill in your values.

# API server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Stock universe (comma-separated yfinance symbols)
# Default is 20 liquid US equities. Add/remove as needed.
DEFAULT_TICKERS=AAPL,MSFT,NVDA,AMZN,META,GOOGL,AMD,AVGO,TSLA,CRM,JPM,LLY,COST,NFLX,UBER,ADBE,PLTR,AMAT,QCOM,PANW
DEFENSIVE_TICKERS=SH,PSQ

# Profit target (fraction, default 0.10 = 10%)
PROFIT_TARGET=0.10

# Trade-planning defaults
DEFAULT_ACCOUNT_SIZE=5000
DEFAULT_DAILY_PROFIT_TARGET=20
MAX_POSITIONS=5
RISK_PER_TRADE_PCT=0.01
MIN_HOLD_DAYS=3
MAX_HOLD_DAYS=15
BACKTEST_LOOKBACK_BARS=120
PAPER_LEARNING_RATE=0.15
PAPER_AUTO_TRADING_ENABLED=false
PAPER_AUTO_CYCLE_INTERVAL_MINUTES=15
HISTORY_CACHE_DIR=.cache/history
ALPHA_VANTAGE_API_KEY=

# External provider API keys (local only - do not commit real secrets)
FMP_API_KEY=
FINNHUB_API_KEY=
PROVIDER_TIMEOUT_SECONDS=10

# CORS origins. Use * for open access or comma-separated list of allowed origins.
ALLOWED_ORIGINS=*

# Data sync interval in minutes (how often background tasks refresh stock data)
DATA_SYNC_INTERVAL_MINUTES=15
